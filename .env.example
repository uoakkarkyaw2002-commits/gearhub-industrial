NODE_ENV=development
PORT=3000
TRUST_PROXY=true
WEB_CONCURRENCY=1
# Production: exact HTTPS origin, no path, and the attached disk mount.
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=./data
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
PASSWORD_RESET_EMAIL=
SMTP_USER=
SMTP_APP_PASSWORD=
# Product/receipt uploads default to DATA_DIR/uploads and DATA_DIR/receipts.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
# Optional off-site backup. Keep bucket private and apply a lifecycle policy.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=gearhub/
# Optional AES256 or aws:kms on providers that support it.
BACKUP_S3_ENCRYPTION=
REQUEST_LOGS=false
# Production does not seed demo inventory unless explicitly enabled.
SEED_DEMO=false

# Optional recovery Gmail delivery; uses existing SMTP/reset-recipient settings.
BACKUP_EMAIL_ENABLED=false
ALERT_EMAIL_ENABLED=false

# Use real owner-approved values or configure payment in Admin.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
PAYMENT_INSTRUCTIONS=

# Multi-store development preview. Keep false until reviewed migration/deployment.
PLATFORM_ENABLED=false
PLATFORM_OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_ORIGIN + /api/platform/auth/callback.

# Play Store app (Trusted Web Activity). SHA-256 fingerprints from Play Console → App integrity
# (App signing key and Upload key), comma separated. Empty = /.well-known/assetlinks.json is 404.
ANDROID_PACKAGE=com.skyshopmm.app
ANDROID_SHA256=
